{
    "name": "md-riaz/mailcamp-larafony",
    "description": "Multi-tenant mail campaign manager built on Larafony MVC",
    "type": "project",
    "require": {
        "php": "^7.4|^8.0",
        "phpmailer/phpmailer": "^6.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\": "database/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
