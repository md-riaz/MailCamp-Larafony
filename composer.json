{
    "name": "md-riaz/mailcamp-larafony",
    "description": "Multi-tenant mail campaign manager built on Larafony Framework",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "larafony/core": "dev-main",
        "phpmailer/phpmailer": "^6.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "symfony/var-dumper": "^7.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "post-create-project-cmd": [
            "@php -r \"copy('.env.example', '.env');\""
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/DJWeb-Damian-Jozwiak/framework"
        }
    ]
}
