{
    "name": "md-riaz/mailcamp-larafony",
    "description": "Multi-tenant mail campaign manager built on Larafony Framework",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "larafony/core": "^2.0.0",
        "phpmailer/phpmailer": "^6.8",
        "paragonie/sodium_compat": "^2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "symfony/var-dumper": "^7.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "post-create-project-cmd": [
            "@php -r \"copy('.env.example', '.env');\""
        ]
    },
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
